{
  "name": "sfi-dash-monitoring-root",
  "description": "Dashboard de monitoring réseau SFI avec visualisation Elasticsearch et WebSocket temps réel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "SFI Team",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:log": "npm run dev:log --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:all": "npm run test --workspaces",
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "start:log": "concurrently \"npm run start --workspace=backend\" \"npm run dev:log --workspace=frontend\"",
    "start:backend": "npm run start --workspace=backend",
    "backend": "npm run start --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "setup": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
